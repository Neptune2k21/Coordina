<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture rules as Roslyn analyzers, so they show in the IDE while
    typing and fail the API build. Roslyn loads analyzers into the compiler,
    which needs netstandard2.0 and a Microsoft.CodeAnalysis no newer than the
    SDK's own.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <CoordinaGraphEngine>false</CoordinaGraphEngine>
    <!-- Release tracking is for analyzers shipped as packages; these only build this repository. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coordina.Analyzers.Tests" />
  </ItemGroup>

</Project>
