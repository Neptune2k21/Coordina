<Project>
  <PropertyGroup>
    <CoordinaGraphEngineSourceRoot>$(MSBuildThisFileDirectory)src/graph-engine/src</CoordinaGraphEngineSourceRoot>
    <CoordinaGraphEngineInclude>$(MSBuildThisFileDirectory)src/graph-engine/include</CoordinaGraphEngineInclude>
    <CoordinaGraphEngineOptimization Condition="'$(Configuration)' == 'Debug'">-O0 -g</CoordinaGraphEngineOptimization>
    <CoordinaGraphEngineOptimization Condition="'$(CoordinaGraphEngineOptimization)' == ''">-O2</CoordinaGraphEngineOptimization>
  </PropertyGroup>

  <ItemGroup>
    <CoordinaGraphEngineSource Include="$(CoordinaGraphEngineSourceRoot)/**/*.cpp" />
    <CoordinaGraphEngineInput Include="@(CoordinaGraphEngineSource);$(CoordinaGraphEngineSourceRoot)/**/*.h;$(CoordinaGraphEngineInclude)/**/*.h;$(MSBuildThisFileFullPath)" />
  </ItemGroup>

  <Target
    Name="BuildCoordinaGraphEngine"
    BeforeTargets="CopyFilesToOutputDirectory"
    Inputs="@(CoordinaGraphEngineInput)"
    Outputs="$(TargetDir)libcoordina_graph_engine.so"
    Condition="'$(CoordinaGraphEngine)' != 'false' and $([MSBuild]::IsOSPlatform('Linux')) and Exists('$(CoordinaGraphEngineSourceRoot)/interop/coordina_graph_engine.cpp')">
    <Exec Command="g++ -std=c++20 $(CoordinaGraphEngineOptimization) -fPIC -pthread -shared -Wall -Wextra -Wpedantic -Werror -I&quot;$(CoordinaGraphEngineInclude)&quot; -I&quot;$(CoordinaGraphEngineSourceRoot)&quot; @(CoordinaGraphEngineSource, ' ') -o &quot;$(TargetDir)libcoordina_graph_engine.so&quot;" />
  </Target>

  <Target
    Name="PublishCoordinaGraphEngine"
    BeforeTargets="CopyFilesToPublishDirectory"
    DependsOnTargets="BuildCoordinaGraphEngine"
    Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('$(TargetDir)libcoordina_graph_engine.so')">
    <Copy
      SourceFiles="$(TargetDir)libcoordina_graph_engine.so"
      DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
