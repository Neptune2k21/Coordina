POSTGRES_USER=coordina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coordina
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ADMINER_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

Auth__Issuer=Coordina.Api
Auth__Audience=Coordina.Web
Auth__SigningKey=change-me-to-a-secure-random-secret-with-at-least-32-characters
Auth__AccessTokenMinutes=15
Auth__RefreshTokenDays=14

# Origins the web app is served from, one per index. Development allows the
# local Vite ports (src/api/appsettings.Development.json); any other
# environment refuses to start without at least one.
# Cors__AllowedOrigins__0=https://app.example.com
